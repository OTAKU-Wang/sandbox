# CDS production environment TEMPLATE (W6 git hygiene).
# Copy to .env.prod locally (git-ignored) and fill REAL values; production
# secrets must come from Kubernetes Secret, Vault, HSM or the target platform
# secret manager. NEVER commit .env.prod — it is on .gitignore, and every
# secret that EVER entered git history must be rotated (see
# docs/cubesandbox-parity-plan.md W6).

# --- Core app ---
CDS_DEBUG=false
CDS_ENV=production
CDS_SECRET_KEY=change_me_unique_48byte_random_value
CDS_JWT_SECRET_KEY=change_me_unique_48byte_random_value

# --- Database / cache ---
CDS_DATABASE_URL=postgresql+asyncpg://cds:change_me_postgres_password@db-host:5432/cds
CDS_REDIS_URL=redis://:change_me_redis_password@redis-host:6379/0
CDS_CLICKHOUSE_URL=http://clickhouse-host:8123/cds_audit
CLICKHOUSE_PASSWORD=change_me_clickhouse_password

# --- Object storage / KMS / HSM ---
MINIO_ROOT_USER=cds_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
CDS_VAULT_ADDR=http://vault-host:8200
CDS_VAULT_TOKEN=change_me_vault_token
CDS_HSM_SOFTWARE_FALLBACK_ALLOWED=false

# --- Security posture (fail-closed production defaults) ---
CDS_SECCOMP_FALLBACK_ALLOWED=false
CDS_KMS_REQUIRE_ATTESTATION=true
CDS_ALLOW_SIMULATION=false
CDS_ADMIN_PAGES_ENABLED=false
CDS_METRICS_API_TOKEN=change_me_metrics_token

# --- Ops toggles ---
CDS_LOG_JSON=true
CDS_RATE_LIMIT_ENABLED=true
