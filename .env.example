# CDS productization environment example.
# Copy to .env for local development only. Production secrets must come from
# Kubernetes Secret, Vault, HSM or the target platform secret manager.

# Compose middleware passwords
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_PASSWORD=change_me_redis_password
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
MINIO_ROOT_USER=cds_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
VAULT_TOKEN=change_me_vault_token

# API runtime configuration. The backend Settings class uses the CDS_ prefix.
CDS_DEBUG=true
CDS_DATABASE_URL=postgresql+asyncpg://cds:change_me_postgres_password@localhost:5432/cds
CDS_REDIS_URL=redis://:change_me_redis_password@localhost:6379/0
CDS_CLICKHOUSE_URL=http://localhost:8123/cds_audit
CDS_OPA_URL=http://localhost:8181
CDS_VAULT_ADDR=http://localhost:8200
CDS_VAULT_TOKEN=change_me_vault_token
CDS_MINIO_ENDPOINT=localhost:9001
CDS_MINIO_ACCESS_KEY=cds_minio_admin
CDS_MINIO_SECRET_KEY=change_me_minio_password
CDS_JWT_SECRET_KEY=change_me_at_least_32_bytes_for_hs256_prod

# Sandbox / TEE
CDS_SANDBOX_K8S_NAMESPACE=cds-sandbox
CDS_SANDBOX_K8S_IMAGE=python:3.12-slim
# N7: use the official kubernetes python client (true) or shell out to kubectl
# (false). Automatically falls back to kubectl when no cluster is reachable.
CDS_K8S_USE_PYTHON_CLIENT=true
# N7: storage class for shared-volume PVCs (must support ReadWriteMany).
# Empty = cluster default class; honest error when none is available.
CDS_SANDBOX_K8S_STORAGE_CLASS=
CDS_TEE_MODE=auto
CDS_TEE_ALLOW_SOFTWARE_FALLBACK=true

# PZ-04/PZ-05 (specs/ss-11-cds-productization.md §7.1) — honesty & federation gates.
# In production, validate_security_config RAISES when these stay at dev defaults:
#   CDS_SM3_FALLBACK_ALLOWED must be false (install gmssl; no SHA-256 for SM3),
#   CDS_COLUMN_ENCRYPTION_KEY must be set (16-byte DEK, hex or base64),
#   CDS_ATTESTATION_ALLOWED_MEASUREMENTS must be set when KMS_REQUIRE_ATTESTATION=true,
#   federation (CDS_FEDERATION_ENABLED=true) needs real mTLS material below.
CDS_MIA_SHADOW_MODEL=false
CDS_COLUMN_ENCRYPTION_KEY=
CDS_SM3_FALLBACK_ALLOWED=true
CDS_FEDERATION_ENABLED=true
CDS_FEDERATION_CA_BUNDLE=
CDS_FEDERATION_CERT=
CDS_FEDERATION_KEY=
CDS_ATTESTATION_ALLOWED_MEASUREMENTS=

# P0 security hardening (docs/ai-sandbox-gap-remediation-plan.md)
# ---------------------------------------------------------------------------
# Session lifecycle sweep interval (expired sessions / dev sessions / contracts).
CDS_SESSION_CLEANUP_INTERVAL_SECONDS=300
# Fail-closed: reject session-key distribution without TEE attestation.
#   true  = hardened production posture (TEE-backed sandboxes only)
#   false = required for software-only sandbox levels (L0/L3) and local dev
CDS_KMS_REQUIRE_ATTESTATION=false
# Machine-to-machine service token for the KMS volume-key endpoints
# (POST/DELETE /api/v1/kms/volume-keys*). Must equal the volume plugin's
# CDS_VOLUME_PLUGIN_KMS_SERVICE_TOKEN. Empty = volume-key endpoints fail-closed
# (all requests 401). Generate with: openssl rand -hex 32
CDS_KMS_SERVICE_TOKEN=
# Dev sandbox contract gate: require a valid contract covering the attached
# data product before provider data can be loaded into a dev session.
#   true  = production default (fail-closed)
#   false = local dev convenience (data_product_id without contract allowed)
CDS_DEV_SANDBOX_REQUIRE_CONTRACT=false



# SS-19 在线开发环（JupyterLab）：等级默认 l2c = CubeSandbox MicroVM（SS-13 立场）。

# 没有 Cube 节点的部署可显式降到 L0/L3 等真实存在的等级，前端会把真实等级标出来。

CDS_DEV_SANDBOX_LEVEL=l2c

# 开发环反代上游（带 cds-jupyter 服务时才填）与上游令牌；留空 = 不提供开发环入口。

CDS_JUPYTER_PROXY_BASE_URL=

CDS_JUPYTER_UPSTREAM_TOKEN=

# W9 idle auto-pause: default expiry behavior for sessions that do not
# declare their own idle_policy ("kill" | "pause").
CDS_SESSION_DEFAULT_IDLE_POLICY=kill

# W3 distributed rate limiting (Redis fixed window; fail-open on Redis outage)
#   RATE_LIMIT_ENABLED            master switch
#   RATE_LIMIT_PER_MINUTE_IP      anonymous requests (IP bucket)
#   RATE_LIMIT_PER_MINUTE_USER    authenticated requests (JWT sub bucket)
#   RATE_LIMIT_AUTH_PER_MINUTE    /api/v1/auth/login dedicated bucket (per IP)
CDS_RATE_LIMIT_ENABLED=true
CDS_RATE_LIMIT_PER_MINUTE_IP=60
CDS_RATE_LIMIT_PER_MINUTE_USER=600
CDS_RATE_LIMIT_AUTH_PER_MINUTE=10

# W10 streaming exec: concurrent WebSocket streams per session.
CDS_EXEC_STREAM_MAX_CONCURRENT=3
# N10: sandbox-internal agent execution — in-sandbox step/token budgets.
CDS_AGENT_STEP_BUDGET=15
CDS_AGENT_TOKEN_BUDGET=20000
CDS_AGENT_MAX_TOOLS=4

# W14 node health: heartbeat overdue threshold for stale marking.
CDS_NODE_STALE_SECONDS=300

# SS-10 CB-01: Cube (L2') node data plane. Off by default; while off (or with
# no eligible node) l2c requests are honestly rejected with 400 RUNTIME_UNAVAILABLE.
CDS_CUBE_DATAPLANE_ENABLED=false
# Legacy L2 (firecracker) + k8s adapters — deprecated; off by default.
CDS_LEGACY_L2_ENABLED=false
# Node TLS front-proxy sidecar (mTLS; no silent plaintext fallback).
CDS_CUBE_NODE_GRPC_TLS=true
CDS_CUBE_NODE_TLS_CA=
CDS_CUBE_NODE_TLS_CERT=
CDS_CUBE_NODE_TLS_KEY=
CDS_CUBE_NODE_TLS_PROXY_PORT=9443
CDS_CUBE_NODE_GRPC_DEADLINE_MS=5000
CDS_CUBE_NODE_HEARTBEAT_SECONDS=30
CDS_CUBE_RESULTS_DIR=/var/lib/cds/sandbox-results
CDS_CUBE_SANDBOX_IMAGE=cds/cube-sandbox:latest
CDS_CUBE_DEK_LENGTH=16
# CB-04: CubeEgress root CA artifact (CDS-side copy of node /etc/cube/ca/cube-root-ca.crt)
CDS_CUBE_EGRESS_CA=
# CB-06: service token for the cube egress audit ingestion endpoint
# (POST /internal/audit/egress, node audit tailer). Empty = fail-closed 401.
CDS_CUBE_AUDIT_SERVICE_TOKEN=
# CB-05: HMAC key signing the cube template artifact download token
# (cube.master.rootfs.artifact.token) + presigned-URL TTL enforcement.
# Required in production when the cube data plane is enabled.
CDS_CUBE_TEMPLATE_SIGNING_KEY=
CDS_CUBE_TEMPLATE_URL_TTL_SECONDS=3600
CDS_CUBE_TEMPLATE_DIST_RETRY=2

# W16 durable task queue (multi-replica; claims via DB row locks)
# No config keys — table-backed, zero-env.

# W15 shared volumes (bind-mounted into L0 sessions)
CDS_SHARED_VOLUME_ROOT=./data/shared-volumes

# W19 egress audit encryption (SM4-GCM; falls back to JWT secret when empty)
# CDS_AUDIT_ENCRYPTION_KEY=change-me-32-byte-min-secret

# W13 egress audit JSONL (sandbox network decisions; see docs/)
CDS_EGRESS_AUDIT_ENABLED=true
CDS_EGRESS_AUDIT_LOG_PATH=./logs/cds-egress/access.jsonl

# W12 retention janitor (docs/retention.md). 0 = keep forever.
CDS_RETENTION_JANITOR_ENABLED=true
CDS_AUDIT_LOG_RETENTION_DAYS=0
CDS_MERKLE_LEAF_RETENTION_DAYS=0
CDS_ALERT_RETENTION_DAYS=180
CDS_RETENTION_JANITOR_DRY_RUN=true
CDS_RETENTION_JANITOR_BATCH=1000

# Round 45+ (spec N2): experimental Merkle batch pipeline (Redis Stream
# worker). Disabled by default — the audit path anchors via the synchronous
# merkle_service. Enable only for evaluation.
CDS_MERKLE_PIPELINE_ENABLED=false

# Alert and CDC integrations
CDS_ALERT_WEBHOOK_URLS=[]
CDS_CDC_KAFKA_BROKERS=localhost:9092
CDS_CDC_KAFKA_CONNECT_URL=

# PZ-10 (spec ss-11): auth enhancement — MFA (TOTP) + SM2 cert login.
# AUTH_CERT_LOGIN=false disables POST /auth/login/cert (password track only).
# MFA_SECRET_ENCRYPTION_KEY: master secret for SM4-GCM at-rest encryption of
# TOTP secrets / recovery codes. Empty = dev/test fallback to the JWT secret;
# production refuses to boot without it (validate_security_config).
CDS_AUTH_MFA_ENABLED=true
CDS_MFA_TOTP_PERIOD=30
CDS_MFA_TOTP_DIGITS=6
CDS_MFA_RECOVERY_CODE_COUNT=8
CDS_MFA_SECRET_ENCRYPTION_KEY=
CDS_AUTH_CERT_LOGIN=true

# Frontend
VITE_API_BASE_URL=/api/v1
