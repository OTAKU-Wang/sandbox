# CDS remote e2e environment (SS-14) — 2026-10-13
# Source of truth for variable names: docker-compose.yml (root, dev-posture) env blocks.
# The deploy script generates strong random values for the *_PASSWORD/TOKEN/KEY vars.
# Posture: dev-relaxed gates (the documented root-compose deployment) + honest cube flags
# per the KVM decision. The prod-posture gate set is exercised separately in the security track.

# --- middleware credentials (random at deploy) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=cds_minio_admin
MINIO_ROOT_PASSWORD=
VAULT_TOKEN=

# --- app core ---
CDS_JWT_SECRET_KEY=
CDS_KMS_SERVICE_TOKEN=
CDS_CUBE_AUDIT_SERVICE_TOKEN=
CDS_CUBE_TEMPLATE_SIGNING_KEY=
# A301: remote_deploy.sh fail-fast requires BOTH keys below (make_env.sh
# generates them). Prod posture refuses an empty column DEK / MFA key.
CDS_COLUMN_ENCRYPTION_KEY=

# --- cube / sandbox (KVM decision dependent) ---
# A: KVM host  -> true  / TLS=true (sidecar)
# B: remote CP + local node -> true / TLS=true
# C: remote CP only         -> false (honest 400 fail-closed on session create)
CDS_CUBE_DATAPLANE_ENABLED=
CDS_CUBE_NODE_GRPC_TLS=
CDS_LEGACY_L2_ENABLED=false
CDS_SANDBOX_LEGACY_ENABLED=false
CDS_CUBE_RESULTS_DIR=/var/lib/cds/sandbox-results
CDS_CUBE_SANDBOX_IMAGE=cds/cube-sandbox:latest
CDS_CUBE_EGRESS_CA=

# --- auth (MFA kept ON: production-honest; TOTP enrolled during admin onboarding) ---
# CDS_MFA_SECRET_ENCRYPTION_KEY is fail-fast required by remote_deploy.sh —
# MFA enabled with an empty at-rest key is the contradiction A301 registered.
CDS_AUTH_MFA_ENABLED=true
CDS_AUTH_CERT_LOGIN=true
CDS_MFA_SECRET_ENCRYPTION_KEY=
