# audit-tailer.env — 审计 tailer（CDS 组件③）环境模板（SS-10 CB-06 / CB-02）
# 由 install.sh 渲染 __*__ 占位符后落盘 /etc/cds/audit-tailer.env（mode 0640）。
# tailer 二进制本体由 CB-06 交付；本模板约定其读取的全部 AUDIT_TAILER_* 键。

# egress 审计 JSONL 目录（§2.7 默认 /data/log/cube-egress，文件名 access.jsonl）
AUDIT_TAILER_AUDIT_DIR=__CDS_CUBE_AUDIT_DIR__
# CDS 控制面（POST /internal/audit/egress，mTLS 服务证书）
AUDIT_TAILER_CDS_ENDPOINT=__CDS_CUBE_CDS_API_URL__
# 节点标识（幂等键组成：node_id + file_name + offset + line_no）
AUDIT_TAILER_NODE_ID=__CDS_CUBE_NODE_ID__
# offset 水位线持久化文件（tailer 崩溃重启续读，无丢失）
AUDIT_TAILER_OFFSET_FILE=/var/lib/cds/audit-tailer/offset.json
# 本地有界队列上限（行）；溢出 = critical 告警 + 停写保护（红线 5，禁丢弃）
AUDIT_TAILER_QUEUE_MAX=10000
# 推送批间隔（秒）
AUDIT_TAILER_PUSH_INTERVAL_SEC=2
# mTLS 服务证书（certificate_service 签发；与 TLS sidecar 同一 CA 体系）
AUDIT_TAILER_TLS_CERT=/etc/cds/audit-tailer/tls.crt
AUDIT_TAILER_TLS_KEY=/etc/cds/audit-tailer/tls.key
AUDIT_TAILER_TLS_CA=/etc/cds/audit-tailer/ca.crt
# 控制面服务令牌（与 CDS 侧 CDS_CUBE_AUDIT_SERVICE_TOKEN 同值）：
# /internal/audit/egress 同时要求 mTLS 与 Bearer 令牌，缺失则每批 401（fail-closed）
AUDIT_TAILER_SERVICE_TOKEN=__CDS_CUBE_AUDIT_SERVICE_TOKEN__
