# CDS Production Environment
POSTGRES_PASSWORD=cds_prod_2026!
REDIS_PASSWORD=cds_redis_2026!
CLICKHOUSE_PASSWORD=cds_ch_2026!
MINIO_ROOT_USER=cds_admin
MINIO_ROOT_PASSWORD=cds_minio_2026!
VAULT_TOKEN=cds_vault_2026!
CDS_JWT_SECRET_KEY=cds_jwt_secret_key_change_me_at_least_32_bytes!!

# ── Production fail-closed posture ─────────────────────────────
# Never run DEBUG in production: it disables the validate_security_config
# posture matrix and the JWT secret requirement.
CDS_DEBUG=false

# Fail-closed switches (validate_security_config surfaces any that remain
# enabled at startup).
CDS_SECCOMP_FALLBACK_ALLOWED=false   # never retry exec without seccomp
CDS_HSM_SOFTWARE_FALLBACK_ALLOWED=false  # Vault is required; no software KEK fallback
CDS_FEDERATION_JWT_KEY_REQUIRED=true

# Hardware-gated switches — keep true until a real TEE/GPU backend is
# provisioned (FG-001/FG-002). ALLOW_SIMULATION=false would block KMS key
# distribution for software-only L0/L3 levels (which produce no real quote).
CDS_ALLOW_SIMULATION=true
CDS_TEE_ALLOW_SOFTWARE_FALLBACK=true
CDS_TEE_SIMULATION_MODE=true
CDS_GPU_TEE_SIMULATION=true
